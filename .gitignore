# Go binaries
/apitest
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test/coverage
*.test
*.out
coverage.html
coverage.txt

# Go module cache (usually in GOPATH, but just in case)
vendor/

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Environment
.env
.env.*
!.env.example

# Build output
dist/
bin/
obj/

# .NET database files
data/*.db
data/*.db-shm
data/*.db-wal
src/ApiTool.Backend/Data/*.db
src/ApiTool.Backend/Data/*.db-shm
src/ApiTool.Backend/Data/*.db-wal

# .NET test output
TestResults/
**/TestResults/

# .NET language server cache
*.lscache

# Claude Code harness runtime
.claude/scheduled_tasks.lock

# Auth profile credential cache (contains obfuscated sensitive values)
.apitest/cache/

# Web project
web/node_modules/
web/.svelte-kit/
web/build/
web/test-results/
web/playwright-report/

# Stub server runtime logs (generated by testdata/m14/stub-backend.sh start --bg)
testdata/m14/*.log

# Python bytecode (from scripts/fake-sendgrid.py)
__pycache__/
*.pyc

# apitest ui built assets — only the committed placeholder index.html is tracked.
# The directory must be re-included first: the blanket dist/ rule above ignores
# the directory itself, and negations cannot resurrect files inside an ignored dir.
!internal/uiserver/assets/dist/
internal/uiserver/assets/dist/*
!internal/uiserver/assets/dist/index.html
ui/node_modules/
ui/test-results/
ui/playwright-report/
