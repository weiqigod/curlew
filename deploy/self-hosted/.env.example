# Copy to .env and change EVERY secret before first boot.
# See README.md for full variable documentation.

# Ports exposed on the host
BACKEND_PORT=5000
WEB_PORT=3000

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Production

# Postgres — provisioned in this stack; used by M5-016 migrations and beyond
POSTGRES_DB=apitool
POSTGRES_USER=apitool
POSTGRES_PASSWORD=change-me-please

# Redis — no password in the default local stack; set for production
REDIS_PASSWORD=

# JWT signing key — MUST be at least 32 bytes (256 bits)
JWT_SIGNING_KEY=change-me-32-bytes-minimum-please

# EF Core migrations on startup — required for Postgres provider
BACKEND_RUN_MIGRATIONS=1

# First-boot admin bootstrap (both must be set together; password >=12 chars)
# Leave blank to skip bootstrap (e.g., after first boot completes).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
