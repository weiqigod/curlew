{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=data/apitool.db"
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "apitool",
    "Audience": "apitool"
  },
  "ApiTool": {
    "App": {
      "WebAppUrl": ""
    }
  },
  "Oidc": {
    "BackendBaseUrl": "http://localhost:5000",
    "DiscoveryCacheTtl": "00:15:00",
    "StateCookieTtl": "00:10:00",
    "StateCookieName": "apitool_oidc_state",
    "NonceCookieName": "apitool_oidc_nonce",
    "PkceCookieName": "apitool_oidc_pkce"
  }
}
