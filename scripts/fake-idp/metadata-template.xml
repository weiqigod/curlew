<?xml version="1.0" encoding="UTF-8"?>
<!--
  SAML 2.0 EntityDescriptor for the fake IdP sidecar.
  {{CERT_BODY}} is replaced at runtime with the base64-encoded DER cert
  (PEM lines without the header/footer).
-->
<md:EntityDescriptor
  xmlns:md="urn:oasis:names:tc:SAML:2.0:metadata"
  entityID="http://fake-idp:8088/metadata">
  <md:IDPSSODescriptor
    WantAuthnRequestsSigned="false"
    protocolSupportEnumeration="urn:oasis:names:tc:SAML:2.0:protocol">
    <md:KeyDescriptor use="signing">
      <ds:KeyInfo xmlns:ds="http://www.w3.org/2000/09/xmldsig#">
        <ds:X509Data>
          <ds:X509Certificate>{{CERT_BODY}}</ds:X509Certificate>
        </ds:X509Data>
      </ds:KeyInfo>
    </md:KeyDescriptor>
    <md:SingleSignOnService
      Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
      Location="http://fake-idp:8088/saml/sso" />
  </md:IDPSSODescriptor>
</md:EntityDescriptor>
