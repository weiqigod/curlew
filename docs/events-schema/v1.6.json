{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://curlew.dev/events-schema/v1.6.json",
  "title": "Curlew Agent Event Stream v1.6",
  "description": "NDJSON event stream emitted by curlew run when --events is provided. Each line is one event object matching exactly one of the definitions below. v1.6 adds 'source_file' and 'source_line' to assertion.result, locating the assertion in the collection at the line a developer would edit to change it. Additive over v1.5; a v1.5 consumer is unaffected.",
  "version_status": "stable",
  "oneOf": [
    {
      "$ref": "#/definitions/RunStart"
    },
    {
      "$ref": "#/definitions/RunError"
    },
    {
      "$ref": "#/definitions/RequestStart"
    },
    {
      "$ref": "#/definitions/RequestEnd"
    },
    {
      "$ref": "#/definitions/AssertionResult"
    },
    {
      "$ref": "#/definitions/RunEnd"
    }
  ],
  "definitions": {
    "Header": {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "id",
        "at_ms",
        "kind"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.6",
          "description": "Schema version. Always 1.4 for this stream."
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque run identifier. Same across all events in one run."
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing event counter. Starts at 1 (RunStart)."
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since run start (monotonic; RunStart is always 0)."
        },
        "kind": {
          "type": "string",
          "enum": [
            "run.start",
            "run.error",
            "request.start",
            "request.end",
            "assertion.result",
            "run.end"
          ],
          "description": "Event kind discriminator."
        }
      }
    },
    "EventError": {
      "type": "object",
      "required": [
        "category",
        "message"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "parse",
            "network",
            "config",
            "assertion",
            "auth",
            "input",
            "internal"
          ],
          "description": "Error category from the apierrors taxonomy."
        },
        "code": {
          "type": "string",
          "description": "Stable machine-readable error code (e.g. NETWORK_DNS).",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message."
        },
        "hint": {
          "type": "string",
          "description": "Suggested remediation hint.",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "description": "Source file where the error originated.",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Line number in the source file."
        }
      },
      "additionalProperties": false
    },
    "RunStart": {
      "allOf": [
        {
          "$ref": "#/definitions/Header"
        }
      ],
      "required": [
        "schema_version",
        "run_id",
        "id",
        "at_ms",
        "kind",
        "started_at",
        "curlew_version",
        "cli_args"
      ],
      "properties": {
        "schema_version": {
          "const": "1.6"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "run.start"
        },
        "started_at": {
          "type": "string",
          "description": "RFC3339Nano UTC timestamp when the run began."
        },
        "curlew_version": {
          "type": "string",
          "description": "curlew binary version.",
          "minLength": 1
        },
        "cli_args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CLI arguments passed to the run command. Caller is responsible for redacting sensitive values."
        },
        "collection_file": {
          "type": "string",
          "description": "Path to the collection file, if provided."
        },
        "env_name": {
          "type": "string",
          "description": "Environment name selected for this run, if any."
        },
        "selection": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Names passed via --only for this run. Omitted when --only was not supplied. Added in v1.1."
        }
      },
      "additionalProperties": false
    },
    "RunError": {
      "allOf": [
        {
          "$ref": "#/definitions/Header"
        }
      ],
      "required": [
        "schema_version",
        "run_id",
        "id",
        "at_ms",
        "kind",
        "error"
      ],
      "properties": {
        "schema_version": {
          "const": "1.6"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "run.error"
        },
        "error": {
          "$ref": "#/definitions/EventError"
        }
      },
      "additionalProperties": false
    },
    "RequestStart": {
      "allOf": [
        {
          "$ref": "#/definitions/Header"
        }
      ],
      "required": [
        "schema_version",
        "run_id",
        "id",
        "at_ms",
        "kind",
        "request_id",
        "method",
        "url"
      ],
      "properties": {
        "schema_version": {
          "const": "1.6"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "request.start"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque request identifier. Paired with the corresponding request.end."
        },
        "request_slug": {
          "type": "string",
          "minLength": 1,
          "description": "URL-safe identifier derived from name. NFKD-normalized, lowercased, non-alphanumeric runs collapsed to '-'. Added in v1.2."
        },
        "name": {
          "type": "string",
          "description": "Human-readable request name, if available."
        },
        "method": {
          "type": "string",
          "description": "HTTP method (GET, POST, etc.)."
        },
        "url": {
          "type": "string",
          "description": "Resolved URL for this request."
        },
        "phase": {
          "type": "string",
          "description": "Run phase name, if applicable."
        },
        "source_file": {
          "type": "string",
          "description": "Source file where this request was defined."
        },
        "source_line": {
          "type": "integer",
          "minimum": 1,
          "description": "Line in source_file where this request was defined."
        }
      },
      "additionalProperties": false
    },
    "RequestEnd": {
      "allOf": [
        {
          "$ref": "#/definitions/Header"
        }
      ],
      "required": [
        "schema_version",
        "run_id",
        "id",
        "at_ms",
        "kind",
        "request_id",
        "outcome",
        "duration_ms"
      ],
      "properties": {
        "schema_version": {
          "const": "1.6"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "request.end"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "request_slug": {
          "type": "string",
          "minLength": 1,
          "description": "URL-safe identifier derived from name; matches the paired request.start. Added in v1.2."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "error"
          ],
          "description": "Terminal state: passed=all assertions passed, failed=assertion failure, skipped=skipped by runner, error=network/pre-flight error."
        },
        "status_code": {
          "type": "integer",
          "minimum": 100,
          "description": "HTTP response status code. Absent when outcome=skipped or outcome=error."
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Round-trip duration in milliseconds."
        },
        "wave_index": {
          "type": "integer",
          "minimum": -1,
          "description": "Wave index when running in parallel waves (zero-based; 0 is omitted via omitempty). Sequential runs emit -1. v1.4 corrects the constraint: v1.2 documented minimum 0, but sequential streams have always emitted -1."
        },
        "request_body": {
          "type": "string",
          "description": "Request body content (UTF-8 text, or base64 if request_body_encoding=base64)."
        },
        "request_body_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Original request body size in bytes. Present only when truncated."
        },
        "request_body_truncated": {
          "type": "boolean",
          "description": "True when request body was truncated to body limit."
        },
        "request_body_encoding": {
          "type": "string",
          "enum": [
            "base64"
          ],
          "description": "Present and set to 'base64' when request body content is base64-encoded binary."
        },
        "response_body": {
          "type": "string",
          "description": "Response body content (UTF-8 text, or base64 if response_body_encoding=base64)."
        },
        "response_body_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Original response body size in bytes. Present only when truncated."
        },
        "response_body_truncated": {
          "type": "boolean",
          "description": "True when response body was truncated to body limit."
        },
        "response_body_encoding": {
          "type": "string",
          "enum": [
            "base64"
          ],
          "description": "Present and set to 'base64' when response body content is base64-encoded binary."
        },
        "error": {
          "$ref": "#/definitions/EventError"
        },
        "timing": {
          "$ref": "#/definitions/TimingInfo",
          "description": "Optional connection-phase breakdown. Added in v1.4."
        }
      },
      "additionalProperties": false
    },
    "AssertionResult": {
      "allOf": [
        {
          "$ref": "#/definitions/Header"
        }
      ],
      "required": [
        "schema_version",
        "run_id",
        "id",
        "at_ms",
        "kind",
        "request_id",
        "type",
        "passed",
        "label"
      ],
      "properties": {
        "schema_version": {
          "const": "1.6"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "assertion.result"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "request_slug": {
          "type": "string",
          "minLength": 1,
          "description": "URL-safe slug of the request this assertion belongs to; mirrors the paired request.start. Present whenever the request has a slug, which is every request parsed from a collection."
        },
        "source_file": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the collection or external request file this assertion is written in. Matches the enclosing request.start's source_file."
        },
        "source_line": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based line of this assertion within source_file: the operator key for body and header assertions, the status:, max_duration_ms: or schema: key otherwise, and the list-entry line for cel. Absent for assertions with no YAML origin, such as a runner-synthesised graphql_error."
        },
        "type": {
          "type": "string",
          "enum": [
            "status",
            "body",
            "header",
            "schema",
            "timing",
            "cel",
            "graphql_error"
          ],
          "description": "Assertion kind discriminator. Through v1.3 this field carried a composite string (\"body $.user.name equals\") that this enum never permitted; that phrase is now in \"label\"."
        },
        "target": {
          "type": "string",
          "description": "What the assertion addressed: a JSONPath for body, a header name for header, a schema file or instance path for schema, \"assertions[N]\" for cel. Absent for status and timing."
        },
        "operator": {
          "type": "string",
          "description": "Comparison applied (equals, matches, exists, ...). Absent where the type implies it."
        },
        "label": {
          "type": "string",
          "description": "Assembled human-readable phrase. Equals the value \"type\" carried through v1.3."
        },
        "passed": {
          "type": "boolean",
          "description": "True when the assertion passed."
        },
        "expected": {
          "type": "string",
          "description": "Expected value (stringified)."
        },
        "actual": {
          "type": "string",
          "description": "Actual value (stringified)."
        }
      },
      "additionalProperties": false
    },
    "RunEnd": {
      "allOf": [
        {
          "$ref": "#/definitions/Header"
        }
      ],
      "required": [
        "schema_version",
        "run_id",
        "id",
        "at_ms",
        "kind",
        "duration_ms",
        "total",
        "passed",
        "failed",
        "skipped",
        "exit_code",
        "event_count"
      ],
      "properties": {
        "schema_version": {
          "const": "1.6"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "run.end"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total run duration in milliseconds."
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of requests executed."
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of requests that passed."
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of requests that failed."
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of requests that were skipped."
        },
        "exit_code": {
          "type": "integer",
          "description": "Process exit code. 0 = success, 1 = failure."
        },
        "event_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Total number of events emitted for this run, including RunStart and RunEnd."
        }
      },
      "additionalProperties": false
    },
    "TimingInfo": {
      "type": "object",
      "description": "Connection-phase breakdown for one HTTP exchange, measured via net/http/httptrace. All duration fields are integer microseconds. Phase fields are omitted when the phase did not occur (e.g. pooled connection: no dns/connect/tls). Reflects the final attempt only when retries occurred. Added in v1.4.",
      "required": [
        "total_us"
      ],
      "properties": {
        "dns_us": {
          "type": "integer",
          "minimum": 0,
          "description": "DNS lookup duration (DNSStart to DNSDone)."
        },
        "connect_us": {
          "type": "integer",
          "minimum": 0,
          "description": "TCP connect duration (ConnectStart to ConnectDone)."
        },
        "tls_us": {
          "type": "integer",
          "minimum": 0,
          "description": "TLS handshake duration."
        },
        "ttfb_us": {
          "type": "integer",
          "minimum": 0,
          "description": "Time to first response byte after the request was written."
        },
        "download_us": {
          "type": "integer",
          "minimum": 0,
          "description": "First response byte to body fully read."
        },
        "total_us": {
          "type": "integer",
          "minimum": 0,
          "description": "Do() entry to body fully read."
        },
        "connection_reused": {
          "type": "boolean",
          "description": "True when a pooled connection was reused (no dns/connect/tls phases)."
        },
        "attempts": {
          "type": "integer",
          "minimum": 2,
          "description": "Total attempts when retries occurred (timing reflects the final attempt). Omitted when 1."
        }
      },
      "additionalProperties": false
    }
  }
}
