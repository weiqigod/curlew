<!-- placeholder copy; product/design polish in a later non-M14 commit -->
<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-weight="bold">
          Your Curlew trial is about to expire
        </mj-text>
        <mj-text>
          Hi {{user_email}}, your trial of {{feature}} expires at {{expires_at_local}}.
          Upgrade now to keep using the feature without interruption.
        </mj-text>
        <mj-button href="{{upgrade_url}}" background-color="#0066cc" font-size="16px">
          Upgrade my account
        </mj-button>
        <mj-divider border-color="#eeeeee" />
        <mj-text font-size="12px" color="#999999">
          If you would like to let the trial expire, no action is required --
          {{feature}} will revert to the free-tier limits.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
