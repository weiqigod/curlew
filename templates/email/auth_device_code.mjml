<!-- placeholder copy; product/design polish in a later non-M14 commit -->
<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-weight="bold">
          Your Curlew device login code
        </mj-text>
        <mj-text>
          Enter this code on the device-login page to finish signing in.
          The code expires in {{expires_in_minutes}} minutes.
        </mj-text>
        <mj-text font-size="28px" font-weight="bold" align="center">
          {{user_code}}
        </mj-text>
        <mj-button href="{{verification_url}}" background-color="#0066cc" font-size="16px">
          Open the verification page
        </mj-button>
        <mj-divider border-color="#eeeeee" />
        <mj-text font-size="12px" color="#999999">
          If you did not request a device login, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
