<!-- placeholder copy; product/design polish in a later non-M14 commit -->
<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-weight="bold">
          Your ApiTool account deletion is scheduled
        </mj-text>
        <mj-text>
          We received a request to permanently delete the ApiTool account for
          {{user_email}}. Your data will be deleted on {{finalizes_at_local}}
          (30 days from now).
        </mj-text>
        <mj-text>
          If you did not request this or you change your mind, you can cancel
          before the deadline by clicking the button below.
        </mj-text>
        <mj-button href="{{cancel_url}}" background-color="#cc3300" font-size="16px">
          Cancel account deletion
        </mj-button>
        <mj-text font-size="12px" color="#666666">
          If the button does not work, copy and paste this URL into your browser:
        </mj-text>
        <mj-text font-size="12px">
          <a href="{{cancel_url}}">{{cancel_url}}</a>
        </mj-text>
        <mj-divider border-color="#eeeeee" />
        <mj-text font-size="12px" color="#999999">
          If you did not request account deletion, please contact us immediately.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
