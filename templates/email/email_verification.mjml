<!-- placeholder copy; product/design polish in a later non-M14 commit -->
<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-weight="bold">
          Welcome to ApiTool, {{first_name}}!
        </mj-text>
        <mj-text>
          Click the button below to verify your email address and activate your account.
          This link expires in 24 hours.
        </mj-text>
        <mj-button href="{{verification_url}}" background-color="#0066cc" font-size="16px">
          Verify Email Address
        </mj-button>
        <mj-text font-size="12px" color="#666666">
          If the button does not work, copy and paste this URL into your browser:
        </mj-text>
        <mj-text font-size="12px">
          <a href="{{verification_url}}">{{verification_url}}</a>
        </mj-text>
        <mj-divider border-color="#eeeeee" />
        <mj-text font-size="12px" color="#999999">
          If you did not create an ApiTool account, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
