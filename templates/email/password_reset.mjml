<!-- placeholder copy; product/design polish in a later non-M14 commit -->
<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-weight="bold">
          Reset your ApiTool password
        </mj-text>
        <mj-text>
          We received a password-reset request for {{user_email}} from
          IP {{requester_ip}} ({{requester_ua}}).
          If you made this request, click the button below to set a new password.
          The link expires at {{expires_at_local}}.
        </mj-text>
        <mj-button href="{{reset_url}}" background-color="#0066cc" font-size="16px">
          Reset password
        </mj-button>
        <mj-text font-size="12px" color="#666666">
          If the button does not work, copy and paste this URL into your browser:
        </mj-text>
        <mj-text font-size="12px">
          <a href="{{reset_url}}">{{reset_url}}</a>
        </mj-text>
        <mj-divider border-color="#eeeeee" />
        <mj-text font-size="12px" color="#999999">
          If you did not request a password reset, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
