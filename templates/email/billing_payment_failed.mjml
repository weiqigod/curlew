<!-- placeholder copy; product/design polish in a later non-M14 commit -->
<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-weight="bold">
          Action required: payment issue for {{first_name}}
        </mj-text>
        <mj-text>
          We were unable to process your payment of {{amount_total}}.
          This is attempt {{attempt_count}}. Please update your payment method to avoid
          any interruption to your Curlew subscription.
        </mj-text>
        <mj-button href="{{update_payment_url}}" background-color="#cc3300" font-size="16px">
          Update payment method
        </mj-button>
        <mj-divider border-color="#eeeeee" />
        <mj-text font-size="12px" color="#999999">
          If you believe this is an error, please contact support@apitool.dev.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
